# Public Supabase URL and anon/publishable key for automatic guest sessions.
# NEXT_PUBLIC_SUPABASE_URL is optional when SUPABASE_URL is already set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternative name for newer publishable keys (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile public site key for CAPTCHA-protected guest sign-ins.
# The Turnstile secret key belongs in Supabase Auth CAPTCHA settings only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Supabase secret key (preferred; starts with sb_secret_).
# Never use the publishable/anon key here: RLS will block writes.
SUPABASE_SECRET_KEY=

# Legacy equivalent (service_role JWT). Either name works.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Canonical site origin for auth confirmation redirects.
# Leave empty to use the current browser origin.
# Example for production: https://lovely.raymondwillytan.com
NEXT_PUBLIC_SITE_URL=

# Optional. Used when showing share/edit links in the creator.
# Leave empty locally so links use the current browser origin.
# Example for production: https://lovely.raymondwillytan.com
NEXT_PUBLIC_SHARE_ORIGIN=

# Secret shared with the Vercel Cron job that cleans up abandoned anonymous
# guests. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# Required before the cleanup endpoint can run. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Safety switch for anonymous-user deletion. Leave unset or set to false to
# run the daily cleanup in dry-run mode only. Set to true only after reviewing
# the dry-run reports in public.lovely_cleanup_runs.
ANONYMOUS_CLEANUP_DELETE_ENABLED=false

# Optional. Caps how many candidate guests a single run will examine. Defaults
# to 500 and is clamped to 2000.
ANONYMOUS_CLEANUP_MAX_CANDIDATES=500

# If these are omitted locally, Lovely falls back to .data/lovely/*.json.
# That fallback is for development only and is not reliable on serverless hosts.
